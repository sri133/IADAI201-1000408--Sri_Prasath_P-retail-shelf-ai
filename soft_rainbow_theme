# ============================================================
# SOFT RAINBOW THEME — drop-in replacement
#
# HOW TO USE:
# 1. In app.py, delete the entire body of inject_custom_css()
#    (everything inside the st.markdown("""...""") block) and
#    replace it with the CSS below.
# 2. Also replace the STATUS_COLORS dict near the top of app.py
#    with the softened version at the bottom of this file, so
#    the stock-status colors match the new palette.
# ============================================================

def inject_custom_css():
    st.markdown(
        """
        <style>
        @import url('https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&family=Nunito:wght@400;500;600;700&display=swap');

        html, body, [class*="css"] {
            font-family: 'Nunito', sans-serif;
        }

        h1, h2, h3 {
            font-family: 'Quicksand', sans-serif !important;
            font-weight: 700 !important;
        }

        /* Soft cream base with floating pastel rainbow blobs */
        .stApp {
            background:
                radial-gradient(circle at 12% 18%, rgba(255, 182, 213, 0.35) 0%, transparent 42%),
                radial-gradient(circle at 85% 12%, rgba(173, 216, 255, 0.35) 0%, transparent 42%),
                radial-gradient(circle at 25% 80%, rgba(198, 255, 214, 0.30) 0%, transparent 45%),
                radial-gradient(circle at 80% 75%, rgba(255, 230, 168, 0.30) 0%, transparent 45%),
                radial-gradient(circle at 50% 45%, rgba(220, 198, 255, 0.25) 0%, transparent 50%),
                #fffaf5;
            background-attachment: fixed;
            animation: bgDrift 16s ease-in-out infinite;
        }
        @keyframes bgDrift {
            0%, 100% { filter: saturate(1) brightness(1); }
            50% { filter: saturate(1.08) brightness(1.03); }
        }

        @keyframes fadeSlideIn {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }
        @keyframes floatSoft {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-7px); }
        }
        @keyframes rainbowGlow {
            0%   { box-shadow: 0 0 16px rgba(255, 182, 213, 0.45); }
            25%  { box-shadow: 0 0 16px rgba(173, 216, 255, 0.45); }
            50%  { box-shadow: 0 0 16px rgba(198, 255, 214, 0.45); }
            75%  { box-shadow: 0 0 16px rgba(255, 230, 168, 0.45); }
            100% { box-shadow: 0 0 16px rgba(255, 182, 213, 0.45); }
        }
        @keyframes rainbowText {
            0%   { color: #ff8fb3; }
            25%  { color: #8fc7ff; }
            50%  { color: #7fe0a3; }
            75%  { color: #ffcf7a; }
            100% { color: #ff8fb3; }
        }
        @keyframes gentleBounce {
            0%, 100% { transform: scale(1) translateY(0); }
            50% { transform: scale(1.015) translateY(-2px); }
        }

        h1 {
            font-weight: 700 !important;
            letter-spacing: 0.3px;
            animation: fadeSlideIn 0.6s ease-out, rainbowText 8s ease-in-out infinite;
        }

        h2, h3 {
            color: #b26fd1 !important;
        }

        /* Sidebar — soft pastel gradient panel */
        section[data-testid="stSidebar"] {
            background: linear-gradient(180deg, #fff3f8 0%, #f3f0ff 50%, #eefaf3 100%);
            border-right: 1px solid rgba(255, 182, 213, 0.4);
            box-shadow: 4px 0 20px rgba(198, 173, 255, 0.15);
        }
        section[data-testid="stSidebar"] h1 {
            font-size: 1.4rem !important;
        }

        /* Buttons — soft rounded pill, gentle rainbow glow on hover */
        .stButton > button, .stDownloadButton > button {
            background: #ffffff;
            color: #b26fd1;
            font-weight: 600;
            font-family: 'Quicksand', sans-serif;
            border: 2px solid #ffd3e6;
            border-radius: 999px;
            padding: 0.5rem 1.3rem;
            box-shadow: 0 4px 14px rgba(255, 182, 213, 0.25);
            transition: all 0.25s ease;
        }
        .stButton > button:hover, .stDownloadButton > button:hover {
            border-color: #b8d9ff;
            transform: translateY(-2px) scale(1.02);
            animation: rainbowGlow 3s ease-in-out infinite;
        }

        /* File uploader — soft dashed pastel border, gentle float */
        [data-testid="stFileUploader"] {
            border: 2px dashed #d7c3ff;
            border-radius: 20px;
            padding: 0.7rem;
            background: rgba(255, 255, 255, 0.55);
            animation: floatSoft 5s ease-in-out infinite;
            transition: transform 0.25s ease;
        }
        [data-testid="stFileUploader"]:hover {
            transform: scale(1.01);
        }

        /* Metric cards — soft glass panel, floating with gentle glow */
        [data-testid="stMetric"] {
            background: rgba(255, 255, 255, 0.65);
            border: 1.5px solid rgba(210, 190, 255, 0.5);
            border-radius: 20px;
            padding: 1rem 1.2rem;
            backdrop-filter: blur(6px);
            animation: fadeIn 0.5s ease-out, floatSoft 5s ease-in-out infinite;
            transition: transform 0.25s ease, box-shadow 0.25s ease;
        }
        [data-testid="stMetric"]:hover {
            transform: scale(1.03) translateY(-3px);
            animation: rainbowGlow 3s ease-in-out infinite, floatSoft 5s ease-in-out infinite;
        }
        [data-testid="stMetricLabel"] {
            color: #a98fd1 !important;
            font-family: 'Nunito', sans-serif !important;
        }
        [data-testid="stMetricValue"] {
            color: #ff8fb3 !important;
            font-family: 'Quicksand', sans-serif !important;
        }

        /* Stock status cards — soft pastel left border, gentle bounce on hover */
        .stock-card {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 14px 18px;
            margin-bottom: 10px;
            border-radius: 16px;
            background: rgba(255, 255, 255, 0.7);
            border: 1px solid rgba(0, 0, 0, 0.04);
            border-left: 6px solid var(--status-color, #ffb6d5);
            box-shadow: 0 4px 16px color-mix(in srgb, var(--status-color, #ffb6d5) 25%, transparent);
            transition: all 0.25s ease;
        }
        .stock-card:hover {
            transform: translateX(4px);
            animation: gentleBounce 0.5s ease;
            box-shadow: 0 6px 22px color-mix(in srgb, var(--status-color, #ffb6d5) 40%, transparent);
        }
        .stock-card .cat-name { font-weight: 700; color: #5c4a72; font-family: 'Nunito', sans-serif; }
        .stock-card .cat-count { color: #9a8bb0; }
        .stock-card .cat-status { font-weight: 700; }

        /* Images — soft rounded pastel frame, gentle glow on hover */
        [data-testid="stImage"] img {
            border-radius: 20px;
            border: 3px solid rgba(255, 210, 230, 0.6);
            box-shadow: 0 6px 20px rgba(200, 180, 255, 0.25);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        [data-testid="stImage"] img:hover {
            transform: scale(1.015);
            box-shadow: 0 10px 28px rgba(255, 182, 213, 0.35);
        }

        /* Alerts — soft rounded glass */
        div[data-testid="stAlert"] {
            border-radius: 16px;
            animation: fadeIn 0.5s ease-out;
        }

        /* Sidebar nav — gentle glide + color shift on hover */
        div[role="radiogroup"] label {
            transition: transform 0.2s ease, color 0.2s ease;
        }
        div[role="radiogroup"] label:hover {
            transform: translateX(4px);
            color: #ff8fb3 !important;
        }

        /* Sliders — soft rainbow gradient track */
        .stSlider [data-baseweb="slider"] > div > div {
            background: linear-gradient(90deg, #ffb6d5, #b6d9ff, #b6ffcf, #ffe3a8) !important;
        }

        /* Soft rainbow divider */
        hr {
            border: none;
            height: 3px;
            border-radius: 3px;
            background: linear-gradient(90deg, #ffb6d5, #b6d9ff, #b6ffcf, #ffe3a8, #ffb6d5);
            margin: 1.4rem 0;
        }

        /* Hero banner — soft glass card with floating rainbow border glow */
        .hero-banner {
            padding: 1.6rem 1.8rem;
            border-radius: 24px;
            background: rgba(255, 255, 255, 0.6);
            border: 1.5px solid rgba(210, 190, 255, 0.4);
            backdrop-filter: blur(6px);
            margin-bottom: 1.2rem;
            animation: fadeSlideIn 0.6s ease-out, floatSoft 6s ease-in-out infinite;
        }
        .hero-banner p {
            color: #6b5b80;
            margin: 0;
            font-size: 1.05rem;
            font-family: 'Nunito', sans-serif;
        }

        </style>
        """,
        unsafe_allow_html=True,
    )


# ------------------------------------------------------------------
# Softened status colors — replace the existing STATUS_COLORS dict
# with this one so the stock-card left-border colors match the new
# pastel theme instead of the old neon red/yellow/green.
# ------------------------------------------------------------------
STATUS_COLORS = {
    "Out of Stock": "#ff8f9e",   # soft coral-red
    "Low Stock": "#ffd27a",      # soft amber
    "In Stock": "#7fe0a3",       # soft mint-green
}
